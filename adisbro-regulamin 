<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terms of Service | adisbro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Nunito:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            background-color: #05070a;
            min-height: 100vh;
            font-family: 'Nunito', sans-serif;
            position: relative;
            overflow-x: hidden; 
            padding: 50px 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        /* === TŁO KSĘŻYCOWE (Identyczne) === */
        .bg-nebula {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                radial-gradient(circle at 50% -10%, rgba(120, 150, 200, 0.15) 0%, transparent 60%),
                radial-gradient(circle at 10% 90%, rgba(60, 80, 120, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 90% 80%, rgba(40, 60, 100, 0.15) 0%, transparent 50%);
            z-index: -3;
        }
        .bg-moon {
            position: fixed;
            bottom: -20vh;
            left: 50%;
            transform: translateX(-50%);
            width: 120vw;
            height: 60vh;
            max-width: 1200px;
            border-radius: 50% 50% 0 0;
            background: radial-gradient(ellipse at bottom, rgba(180, 200, 230, 0.15) 0%, rgba(10, 15, 25, 0) 70%);
            z-index: -2;
            filter: blur(10px);
        }
        .bg-stars {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(1.5px 1.5px at 15% 25%, #ffffff, transparent),
                radial-gradient(2px 2px at 40% 15%, #e2e8f0, transparent),
                radial-gradient(1px 1px at 75% 30%, #ffffff, transparent),
                radial-gradient(2.5px 2.5px at 85% 70%, #cbd5e1, transparent),
                radial-gradient(1.5px 1.5px at 20% 80%, #ffffff, transparent),
                radial-gradient(1px 1px at 60% 90%, #e2e8f0, transparent),
                radial-gradient(2px 2px at 10% 50%, #ffffff, transparent),
                radial-gradient(1.5px 1.5px at 90% 10%, #ffffff, transparent);
            background-repeat: repeat;
            background-size: 250px 250px;
            z-index: -1;
            animation: twinkle 4s ease-in-out infinite alternate;
        }
        /* ================================================= */

        .container {
            max-width: 380px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: fadeIn 1.5s ease-out;
            position: relative;
            z-index: 1;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes twinkle {
            0% { opacity: 0.3; }
            100% { opacity: 0.8; }
        }

        .name {
            font-family: 'Caveat', cursive;
            color: #f8fafc;
            font-size: 3.8rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 5px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
            transform: rotate(-1deg);
            text-align: center;
        }

        .bio {
            color: #cbd5e1;
            font-size: 1.05rem;
            margin-bottom: 40px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.9);
            text-align: center;
        }

        .content {
            width: 100%;
            text-align: left;
            margin-bottom: 30px;
        }

        .content p, .content li {
            font-size: 0.95rem;
            line-height: 1.6;
            color: #cbd5e1;
            margin-bottom: 15px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        .content h2 {
            font-size: 1.15rem;
            color: #f8fafc;
            margin-top: 25px;
            margin-bottom: 10px;
            font-weight: 600;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.9);
        }

        .content ul {
            margin-left: 20px;
            margin-bottom: 15px;
        }

        .content strong {
            color: #f8fafc;
        }

        .link-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: #f1f5f9;
            font-size: 1.15rem;
            font-weight: 600;
            padding: 12px 5px;
            width: 100%;
            border-bottom: 1.5px dashed rgba(203, 213, 225, 0.4);
            transition: all 0.3s ease;
            cursor: pointer;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
            margin-top: 20px;
        }

        .link-left { display: flex; align-items: center; gap: 15px; }
        
        .link-item i { font-size: 1.2rem; color: #94a3b8; transition: all 0.3s ease; }
        
        .link-item:hover { 
            border-bottom: 1.5px solid #ffffff; 
            color: #ffffff;
        }
        
        .link-item:hover i { color: #ffffff; }
        
        .arrow { font-size: 1rem; opacity: 0.6; transition: transform 0.3s ease, opacity 0.3s ease; }
        .link-item:hover .arrow { transform: translateX(6px); opacity: 1; color: #ffffff; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #05070a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }
    </style>
</head>
<body>

    <div class="bg-nebula"></div>
